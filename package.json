{
  "name": "@dlenroc/capnweb-node-ipc",
  "version": "1.1.1",
  "description": "Local IPC transport for Cap'n Web on Node.js",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dlenroc/capnweb-node-ipc.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown --no-config --format esm,cjs",
    "prepack": "npm run build"
  },
  "dependencies": {
    "msgpackr": "^2.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsdown": "^0.23.0"
  },
  "peerDependencies": {
    "capnweb": "^0.12.0"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
